{
  "presets": [
    ["@babel/preset-env", {
      "targets": {
        "node": "current"
      }
    }]
  ],
  "env": {
    "test": {
      "presets": [
        ["@babel/preset-env", {
          "targets": {
            "node": "current"
          }
        }]
      ]
    },
    "production": {
      "presets": [
        ["@babel/preset-env", {
          "modules": false,
          "targets": {
            "node": "current"
          }
        }]
      ]
    }
  }
}
