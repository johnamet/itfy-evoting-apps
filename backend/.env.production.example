# ================================
# File Upload Configuration
# ================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ================================
# Logging & Monitoring
# ================================
LOG_LEVEL=info
LOG_DIR=./logs

# RECOMMENDED: Set up Sentry for error tracking
SENTRY_DSN=https://a0dbb0b6fdb235062c85b39855ffc0f2@o4510666017669120.ingest.us.sentry.io/4510666019831808
SENTRY_TRACES_RATE=0.1

# ================================
# PM2 Process Management
# ================================
PM2_INSTANCES=max
PM2_MAX_MEMORY=1G

# ================================
# Security Configuration
# ================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100

# Session/Cookie Security
SESSION_SECRET=GENERATE_64_BYTE_SECRET_FOR_SESSIONS
COOKIE_SECURE=true
COOKIE_SAME_SITE=strict

# ================================
# API Documentation
# ================================
# Disable Swagger in production or protect with auth
