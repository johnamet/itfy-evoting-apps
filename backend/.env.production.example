# ITFY E-Voting Backend - PRODUCTION Configuration
# ================================================
# SECURITY WARNING: This is a TEMPLATE file only!
# - Copy to .env.production on your production server
# - NEVER commit the actual .env.production file
# - All secrets should be set via environment variables or secret management
# ================================================

# ================================
# Server Configuration
# ================================
NODE_ENV=production
PORT=3000

# CRITICAL: Set exact allowed origins (NEVER use * in production)
# Your frontend domains (comma-separated for multiple)
CORS_ORIGIN=https://evoting.itforyouthghana.org

# ================================
# Database Configuration
# ================================
# Use MongoDB Atlas or a properly secured MongoDB instance
# NEVER include credentials in connection string in code!
# Use environment variables on the server
MONGODB_URI=mongodb+srv://johnametepe_db_user:gwXePKmXJlAeuDKW@itfy-evoting.fnee94x.mongodb.net/evoting?appName=itfy-evoting
DB_MAX_RETRIES=5
DB_RETRY_DELAY_MS=5000

# ================================
# Redis/Cache Configuration
# ================================
# Use a managed Redis instance (Redis Cloud, ElastiCache, etc.)
# Required for production clustering and rate limiting
REDIS_URL=redis://localhost:6379
REDIS_MAX_RETRIES=5
REDIS_RETRY_DELAY_MS=2000
USE_IN_MEMORY_CACHE=false

# ================================
# JWT Configuration
# ================================
# CRITICAL: Generate strong secrets!
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
# NEVER reuse secrets across environments!
JWT_SECRET=GENERATE_NEW_64_BYTE_BASE64_SECRET
JWT_REFRESH_SECRET=GENERATE_ANOTHER_64_BYTE_BASE64_SECRET
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
JWT_ISSUER=itfy-evoting
JWT_AUDIENCE=itfy-evoting-app

# ================================
# Email Configuration
# ================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=true
EMAIL_USER=johnametepe@itforyouthghana.org
EMAIL_PASSWORD=acdb pvpy ynpv pebo
EMAIL_FROM=johnametepe@itforyouthghana.org

# ================================
# Frontend Configuration
# ================================
FRONTEND_URL=https://evoting.itforyouthghana.org

# ================================
# Payment Configuration (Paystack)
# ================================
# CRITICAL: Use LIVE keys in production!
PAYSTACK_SECRET_KEY=sk_test_4f1e1e8a66187da4be79551ffd1eb7a80c373e91
PAYSTACK_PUBLIC_KEY=pk_test_fcb27f4dc8f032b0d7b314407b08d02493dd2f4f
