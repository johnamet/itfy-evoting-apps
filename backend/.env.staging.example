# ITFY E-Voting Backend - STAGING Configuration
# ==============================================
# SECURITY WARNING: This is a TEMPLATE file only!
# - Copy to .env.staging on your staging server
# - NEVER commit the actual .env.staging file
# ==============================================

# ================================
# Server Configuration
# ================================
NODE_ENV=staging
PORT=3000

# Staging frontend URL
CORS_ORIGIN=https://staging.evoting.itforyouthghana.org,https://evoting.itforyouthghana.org

# ================================
# Database Configuration
# ================================
# Use a SEPARATE database for staging!
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/evoting_staging?retryWrites=true&w=majority
DB_MAX_RETRIES=5
DB_RETRY_DELAY_MS=5000

# ================================
# Redis/Cache Configuration
# ================================
REDIS_URL=redis://localhost:6379
REDIS_MAX_RETRIES=5
REDIS_RETRY_DELAY_MS=2000
USE_IN_MEMORY_CACHE=false

# ================================
# JWT Configuration
# ================================
# Use DIFFERENT secrets than production!
JWT_SECRET=Bnj3:{[&zGjwI#{t4qQajOoEl$+*8+(&&0Tl3WP5c!I]3h@4QzQkkK2qMWZ&UHQJ
JWT_REFRESH_SECRET=TnAvaXlz]c-gx*nkYa49}f+fD-^o=Bw&{he*dJCvl96ttmNkCv![L{S??47,d!Rl
JWT_EXPIRATION=30m
JWT_REFRESH_EXPIRATION=7d
JWT_ISSUER=itfy-evoting-staging
JWT_AUDIENCE=itfy-evoting-app-staging

# ================================
# Email Configuration
# ================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=true
EMAIL_USER=staging@itforyouthghana.org
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=staging-noreply@itforyouthghana.org

# ================================
# Frontend Configuration
# ================================
FRONTEND_URL=https://staging.evoting.itforyouthghana.org

# ================================
# Payment Configuration (Paystack)
# ================================
# Use TEST keys for staging!
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxx
PAYSTACK_CALLBACK_URL=https://staging.evoting.itforyouthghana.org/payment/callback
PAYSTACK_WEBHOOK_SECRET=your-staging-webhook-secret
PAYSTACK_TIMEOUT_MS=30000

# ================================
# File Upload Configuration
# ================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ================================
# Logging & Monitoring
# ================================
LOG_LEVEL=debug
LOG_DIR=./logs
SENTRY_DSN=
SENTRY_TRACES_RATE=0.5

# ================================
# PM2 Process Management
# ================================
PM2_INSTANCES=2
PM2_MAX_MEMORY=512M

# ================================
# Security Configuration
# ================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=200

# ================================
# API Documentation
# ================================
SWAGGER_ENABLED=true

# ================================
# Console Configuration
# ================================
CONSOLE_SETUP_COMPLETE=true
